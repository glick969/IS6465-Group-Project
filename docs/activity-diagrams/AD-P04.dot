digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.3", ranksep="0.35", fontname="Arial", fontsize=16, labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#f2f4f1",color="#556659",fontname="Arial",fontsize=12,margin="0.15,0.10"]; edge [fontname="Arial",fontsize=10,color="#526456"]; start [shape=circle,label="",width=.16,style=filled,fillcolor="#263d32"]; end [shape=doublecircle,label="",width=.2,style=filled,fillcolor="#263d32"]; label="AD-P04  Delete or inactivate product\nMidterm activity flow: temporary sample data; no real authentication";

open [label="Employee: select removal option",fillcolor="#fff5e7"];
exists [shape=diamond,label="Product exists?",fillcolor="#fff"];
missing [label="Prototype: not-found; no change"];
history [shape=diamond,label="Historical transactions?",fillcolor="#fff"];
material [shape=diamond,label="Material requirements?",fillcolor="#fff"];
historyUI [label="Prototype: block deletion; offer inactivation"];
materialUI [label="Prototype: explain material blocker; offer inactivation"];
eligibleUI [label="Prototype: show eligible deletion confirmation"];
mergeOptions [shape=diamond,label="",width=.18,height=.18,fixedsize=true,fillcolor="white"];
action [shape=diamond,label="Employee confirms
permitted action?",fillcolor="#fff"];
cancel [label="Prototype: keep record; return to details"];
mutate [label="Prototype: recheck flags; delete eligible record
or set linked record Inactive"];
storage [shape=diamond,label="Temporary save succeeds?",fillcolor="#fff"];
success [label="Prototype: return to list with explicit outcome"];
failure [label="Prototype: show storage failure; no success claim"];
start -> open -> exists; exists -> missing [label="No"]; missing -> end;
exists -> history [label="Yes"]; history -> historyUI [label="Yes"]; history -> material [label="No"];
material -> materialUI [label="Yes"]; material -> eligibleUI [label="No"];
historyUI -> mergeOptions; materialUI -> mergeOptions; eligibleUI -> mergeOptions; mergeOptions -> action;
action -> cancel [label="No / already inactive"]; cancel -> end;
action -> mutate [label="Yes"]; mutate -> storage;
storage -> success [label="Yes"]; success -> end; storage -> failure [label="No"]; failure -> end;
}